# GloLaunch AI 后端环境变量配置
# 复制此文件为 .env 并填入真实 API Key
# cp .env.example .env

# ── 必填 ──────────────────────────────────────────────

# Token Plan 模型网关配置（专属基地址）
# 申请地址：bailian.console.aliyun.com → Token Plan
MODEL_ROUTER_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_ROUTER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ── 模型名称映射（一般无需修改） ──────────────────────

MODEL_TEXT_FLAGSHIP=qwen3.8-max
MODEL_TEXT_PLUS=qwen3.7-plus
MODEL_TEXT_FLASH=qwen3.6-flash
MODEL_VL=qwen3.7-plus

# 多媒体生成模型（未配置或套餐不支持时对应能力自动降级）
MODEL_IMAGE=wan2.7-image-pro
MODEL_TTS=qwen-audio-3.0-tts-plus
TTS_VOICE=longanhuan_v3.6

# ── 可选：第三方数据平台 ─────────────────────────────

# JustOneAPI 聚合数据平台（Amazon/1688/Shopee/TikTok 四源共用）
# 申请地址：justoneapi.com → Dashboard → API Keys
JUSTONEAPI_API_KEY=
JUSTONEAPI_BASE_URL=https://api.justoneapi.com

# ── 可选：1688 开放平台官方 API ───────────────────────

# 申请地址：open.1688.com → 应用管理
# access_token 可留空，配置 AppKey/Secret 后在导入弹窗点「1688 账号授权」走 OAuth
ALI1688_APP_KEY=
ALI1688_APP_SECRET=
ALI1688_ACCESS_TOKEN=
ALI1688_REDIRECT_URI=http://localhost:5173/api/import/1688/oauth/callback

# ── 可选：电商平台直连发布（未配置时自动进入演练模式） ──

PUBLISH_DRY_RUN=true
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# ── 可选：阿里云电商图片翻译（未配置时降级为 Qwen-VL） ─

ALIMT_ACCESS_KEY_ID=
ALIMT_ACCESS_KEY_SECRET=

# ── 可选：虚拟试穿（按需增值服务） ────────────────────

AITRYON_API_KEY=
AITRYON_ENDPOINT=

# ── 本地数据存储路径（一般无需修改） ──────────────────

DATA_DIR=data
CHROMA_DIR=data/chroma
UPLOAD_DIR=uploads
SQLITE_PATH=data/glolaunch.db
